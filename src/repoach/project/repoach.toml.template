# repoach.toml: project configuration for repoach, committed, secret-free.
# Written by `repoach init` from measured facts; edit freely.
# Every key is optional. A commented-out line shows the built-in default.
# Precedence: command-line flag > REPOACH_* environment > this file > default.
# Credentials never go here: a key ending in _key, _token or _secret is refused.

[repoach]
schema = 1
# github or gitlab; inferred from the origin remote when absent.
# forge = "github"
# Branch that pull/merge requests target, and the branch releases land on.
# integration_branch = "develop"
# release_branch = "main"
# squash, merge or rebase.
# merge_method = "squash"
# remove_source_branch = true
# specs_dir = "docs/specs"
# plans_dir = "docs/plans"

[project]
# Measured by `repoach init` from the tracked files.
# languages = ["python"]
# src_roots = ["src"]
# test_roots = ["tests"]
# Reviewer personas; always forbidden to the Coder.
# prompts_dir = "prompts/review"

[commands]
# The project's own lint and test commands; an empty string means none.
# lint = "ruff check src tests && ruff format --check src tests"
# test = "pytest -q tests/unit"
# The project's own pre-push barrier, optional. A command that needs an
# environment variable spells it with env, not a VAR= prefix:
#   (gate = "env YOOB_CI_WAIT=1 ./ci/run-local-ci.sh --affected")
# gate = ""
# Seconds each command may run before it is killed.
# timeout_s = 900
# Any other key is a named command a gate selector cmd:<name> may run:
# e2e = "npm run e2e"

[coder]
# Paths added to the Coder's built-in forbidden list.
# forbidden_prefixes = []
# forbidden_paths = []

[provider]
# claude_code, anthropic, openai_compatible, gemini or gateway, or a preset
# (openai, ollama, openrouter, groq, deepseek, mistral). --provider and
# REPOACH_PROVIDER override it. The credential itself stays in the environment
# or ~/.config/repoach/env. claude_code: the logged-in Claude Code CLI, no key.
# anthropic: REPOACH_ANTHROPIC_API_KEY, else ANTHROPIC_API_KEY.
# openai_compatible: base_url below, REPOACH_OPENAI_API_KEY, else OPENAI_API_KEY.
# gemini: REPOACH_GEMINI_API_KEY, else GEMINI_API_KEY, else GOOGLE_API_KEY.
# gateway: REPOACH_LLM_PROXY_BASE_URL.
# kind = ""
# Model per tier; required for openai_compatible, gemini and the presets.
# opus = ""
# sonnet = ""
# haiku = ""
# claude_code only: the claude executable; empty means claude on PATH.
# cli_path = ""
# openai_compatible only (a preset or gemini: overrides their root).
# base_url = ""

[review]
# Forge login the review bot posts as; markers are trusted from it only.
# Default: github-actions[bot] on GitHub, nobody on GitLab.
# bot_username = ""
# Where a pull request's spec id comes from, in order.
# spec_sources = ["flag", "description", "branch"]

[gates]
# Paths exempt from docstring rules. Default: the test roots
# (repoach itself: tests/, scripts/, src/repoach/llm_proxy/).
# docstring_exempt = ["tests/"]
# Verifiers that report without blocking, and verifiers turned off.
# advisory_verifiers = []
# disabled_verifiers = []
# A verifier's command, by verifier name.
# verifier_commands = {}

[arch]
# frontier_suppress = []
# Whether every spec needs YAML frontmatter. Default: true on repoach
# itself, false on any other repository.
# require_frontmatter = false

[state]
# Ledger and diagnostic dumps; empty means ~/.local/share/repoach/<project>/.
# A path here must stay inside the repository.
# db_path = ""
# logs_dir = ""

# Commit, branch and title conventions (SP-CONVENTIONS-GATE).
# [conventions]
# types = ["feat", "fix", "perf", "refactor", "docs", "test", "build", "ci", "chore", "style", "revert"]
# scopes = "[a-z0-9._/-]+"
# branch_pattern = "<type>/<slug>"
# exempt_branches = ["main", "develop"]
# pr_title = true
# breaking = true
# english = true
# header_max_chars = 72
