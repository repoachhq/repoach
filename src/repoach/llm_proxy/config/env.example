# LLM proxy (sidecar) — env template.
#
# Every key ships under the canonical ``REPOACH_*`` namespace.
# The bare legacy names (``MODEL``, ``NVIDIA_NIM_API_KEY``,
# ``ANTHROPIC_AUTH_TOKEN``, ``HOST`` / ``PORT``, …) remain accepted
# by the dual-read aliases in ``llm_proxy.config.settings`` so
# existing deployments continue working; ``REPOACH_*`` wins when
# both are set, and only new ``.env`` files should ship in the
# canonical form.


# NVIDIA NIM Config
REPOACH_NVIDIA_NIM_API_KEY=""


# OpenRouter Config
REPOACH_OPENROUTER_API_KEY=""


# Capability chains (MODEL_OPUS / MODEL_SONNET / MODEL_HAIKU)
# live ONLY in the version-controlled ``chains.env`` at the repo root —
# SP-CHAINS-SINGLE-SOURCE (2026-06-21) makes that file authoritative, so a
# ``REPOACH_MODEL_*`` here would be ignored. Edit the chains in chains.env.
#
# ``MODEL`` is the plain fallback model (provider_type/model/name) for
# requests that match no tier.
# Valid providers: "nvidia_nim" | "open_router" | "claude_code"
REPOACH_PROXY_DEFAULT_MODEL="nvidia_nim/z-ai/glm4.7"


# Thinking output
# Global switch for provider reasoning requests and Claude thinking blocks.
# Set false to suppress thinking across NIM and OpenRouter.
REPOACH_PROXY_ENABLE_THINKING=true


# Provider config
# Per-provider proxy support: http and socks5, example: "http://username:password@host:port"
REPOACH_NVIDIA_NIM_PROXY=""
REPOACH_OPENROUTER_PROXY=""

REPOACH_PROXY_PROVIDER_RATE_LIMIT=40
REPOACH_PROXY_PROVIDER_RATE_WINDOW=60
REPOACH_PROXY_PROVIDER_MAX_CONCURRENCY=5


# HTTP client timeouts (seconds) for provider API requests
REPOACH_PROXY_HTTP_READ_TIMEOUT=120
REPOACH_PROXY_HTTP_WRITE_TIMEOUT=10
REPOACH_PROXY_HTTP_CONNECT_TIMEOUT=2


# Optional server API key (Anthropic-style)
REPOACH_ANTHROPIC_AUTH_TOKEN=
