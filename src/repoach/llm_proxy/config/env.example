# LLM proxy (sidecar) — env template.
#
# SP-ENV-PREFIX Phase B (2026-05-24) : every key under the unified
# ``FEROVA_*`` namespace.  The bare-prefixed legacy names
# (``MODEL_OPUS``, ``NVIDIA_NIM_API_KEY``, ``ANTHROPIC_AUTH_TOKEN``,
# ``HOST`` / ``PORT``, …) remain accepted by the Phase-A1 dual-read
# shim in ``llm_proxy.config.settings`` so existing deployments
# continue working ; only new ``.env`` files should ship in the
# unified form.  See ``docs/specs/2026-05-05_SP-ENV-PREFIX_*.md``.


# NVIDIA NIM Config
FEROVA_NVIDIA_NIM_API_KEY=""


# OpenRouter Config
FEROVA_OPENROUTER_API_KEY=""


# Capability chains (MODEL_OPUS / MODEL_SONNET / MODEL_HAIKU)
# live ONLY in the version-controlled ``chains.env`` at the repo root —
# SP-CHAINS-SINGLE-SOURCE (2026-06-21) makes that file authoritative, so a
# ``FEROVA_MODEL_*`` here would be ignored. Edit the chains in chains.env.
#
# ``MODEL`` is the plain fallback model (provider_type/model/name) for
# requests that match no tier.
# Valid providers: "nvidia_nim" | "open_router" | "claude_code"
FEROVA_PROXY_DEFAULT_MODEL="nvidia_nim/z-ai/glm4.7"


# Thinking output
# Global switch for provider reasoning requests and Claude thinking blocks.
# Set false to suppress thinking across NIM and OpenRouter.
FEROVA_PROXY_ENABLE_THINKING=true


# Provider config
# Per-provider proxy support: http and socks5, example: "http://username:password@host:port"
FEROVA_NVIDIA_NIM_PROXY=""
FEROVA_OPENROUTER_PROXY=""

FEROVA_PROXY_PROVIDER_RATE_LIMIT=40
FEROVA_PROXY_PROVIDER_RATE_WINDOW=60
FEROVA_PROXY_PROVIDER_MAX_CONCURRENCY=5


# HTTP client timeouts (seconds) for provider API requests
FEROVA_PROXY_HTTP_READ_TIMEOUT=120
FEROVA_PROXY_HTTP_WRITE_TIMEOUT=10
FEROVA_PROXY_HTTP_CONNECT_TIMEOUT=2


# Optional server API key (Anthropic-style)
FEROVA_ANTHROPIC_AUTH_TOKEN=
