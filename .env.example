# Ferova — configuration template.
# Copy to .env (never commit the actual .env file).

# ==== Environment ====
FEROVA_ENV=dev
FEROVA_LOG_LEVEL=INFO

# ==== Storage (review-team persistence) ====
FEROVA_DB_PATH=./data/ferova.db

# ==== LLM proxy sidecar (serves the review factory) ====
FEROVA_LLM_PROXY_BASE_URL=http://localhost:8082
# Mandatory for any agent run and for non-loopback proxy binds —
# the proxy refuses to construct settings with a public host and an
# empty token, and AgentLoop refuses to start without it.
FEROVA_ANTHROPIC_AUTH_TOKEN=
FEROVA_PROXY_HOST=127.0.0.1
FEROVA_PROXY_PORT=8082

# ==== Provider API keys (read by the proxy) ====
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=

# ==== Model chains (canonical defaults live in chains.env; .env wins) ====
# FEROVA_MODEL_OPUS=
# FEROVA_MODEL_SONNET=
# FEROVA_MODEL_HAIKU=
# FEROVA_MODEL_CODER=

# ==== Review push notification (optional) ====
FEROVA_CLAUDE_CODE_ROUTINE_ID=
FEROVA_CLAUDE_CODE_ROUTINE_TOKEN=
