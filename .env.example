# Repoach — configuration template.
#
# Copy to .env (never commit the actual .env file) and set what you need.
# Every knob Repoach reads is listed here. Values shown after "=" on
# commented lines are the built-in defaults — uncomment only to override.
#
# REPOACH_ is the only prefix read for core settings; a handful of
# llm_proxy vars additionally accept their bare legacy names (see
# src/repoach/llm_proxy/config/env.example), with REPOACH_ winning when
# both are set. Secrets stay empty here and are filled in your private
# .env.

# =====================================================================
# ESSENTIALS — set these to get a working install
# =====================================================================

# ---- Environment & logging ----
REPOACH_ENV=dev
REPOACH_LOG_LEVEL=INFO

# ---- Storage (review-team persistence, SQLite) ----
REPOACH_DB_PATH=./data/repoach.db

# ---- LLM proxy sidecar (serves the agent fleet) ----
REPOACH_LLM_PROXY_BASE_URL=http://localhost:8082
REPOACH_PROXY_HOST=127.0.0.1
REPOACH_PROXY_PORT=8082
# Mandatory for any agent run and for non-loopback proxy binds — the
# proxy refuses to construct settings with a public host and an empty
# token, and AgentLoop refuses to start without it.
REPOACH_ANTHROPIC_AUTH_TOKEN=

# ---- Provider API keys (bring your own model) ----
# Set the keys for the providers your chains actually use. Every field
# is optional on its own; a provider with an empty key is skipped.
REPOACH_NVIDIA_NIM_API_KEY=
REPOACH_OPENROUTER_API_KEY=
REPOACH_OPENAI_API_KEY=
REPOACH_ANTHROPIC_API_KEY=
REPOACH_CEREBRAS_API_KEY=
REPOACH_DEEPSEEK_API_KEY=
REPOACH_GROQ_API_KEY=
REPOACH_KIMI_API_KEY=
REPOACH_ARTIFICIAL_ANALYSIS_API_KEY=
# Generic OpenAI-compatible endpoint (SP-BYO-PROVIDERS): point Repoach
# at any server speaking the OpenAI chat API (vLLM, Ollama, LM Studio,
# a private gateway). Leave blank to disable.
REPOACH_OPENAI_COMPATIBLE_API_KEY=
REPOACH_OPENAI_COMPATIBLE_BASE_URL=
# Optional outbound HTTP(S) proxies for specific providers.
# REPOACH_NVIDIA_NIM_PROXY=
# REPOACH_OPENROUTER_PROXY=

# ---- Model chains ----
# The capability chains live ONLY in the version-controlled chains.env
# at the repo root, under the bare MODEL_OPUS / MODEL_SONNET /
# MODEL_HAIKU keys — SP-CHAINS-SINGLE-SOURCE makes that file
# authoritative, so prefixed entries here would be ignored. Edit the
# chains in chains.env.

# ---- Branch model (forks with a different layout) ----
# The integration branch PRs target and the release branch it promotes
# to. Defaults match this repo; a fork on a single `main` or on
# `staging`/`master` sets these instead of editing code.
# REPOACH_INTEGRATION_BRANCH=develop
# REPOACH_RELEASE_BRANCH=main

# =====================================================================
# REVIEW TEAM — optional, sensible defaults
# =====================================================================

# The bot login whose merges are trusted by the event-driven gate.
# REPOACH_REVIEW_BOT_LOGIN=github-actions[bot]
# Recall past review lessons / build memory before planning, and record
# each build's outcome.
# REPOACH_REVIEW_LESSONS_ENABLED=true
# REPOACH_REVIEW_MEMORY_ENABLED=true
# REPOACH_BUILDER_MEMORY_ENABLED=true
# Agent-memory sidecar (builder memory store).
# REPOACH_AGENTMEMORY_URL=http://localhost:3111

# ---- Auto-merge CI gate (SP-AUTOMERGE-EVENT-DRIVEN) ----
# Wait budget for required CI checks in `review merge` / `review gate`.
# 0 = single evaluation, fail fast — CI sets 0 so the merge job never
# holds the runner slot polling (merge-on-ci.yml retries on CI
# completion). Unset = the local defaults below.
# REPOACH_AUTOMERGE_CI_WAIT_SECONDS=720
# REPOACH_AUTOMERGE_CI_POLL_INTERVAL=30

# ---- Review push notification (optional) ----
# When both are set, the orchestrator fires a routine that spawns a
# fresh Claude Code session pre-loaded with the TeamOutcome JSON.
REPOACH_CLAUDE_CODE_ROUTINE_ID=
REPOACH_CLAUDE_CODE_ROUTINE_TOKEN=

# ---- Planner / Coder knobs ----
# Planner per-session parse-attempt budget (initial attempt + N-1
# refinements); unset or non-integer falls back to 5, clamped to >=1.
# REPOACH_PLANNER_PARSE_ATTEMPTS=5
# CSV of pytest interpreter names/paths for the Coder's local gate
# matrix, e.g. "python3.11,python3.13"; unset -> bare `pytest` on PATH.
# REPOACH_CODER_PYTHONS=

# =====================================================================
# ADVANCED — the proxy is self-tuning; touch these only to override
# =====================================================================

# ---- claude_code hop (optional local CLI provider) ----
# REPOACH_CLAUDE_CODE_CLI_PATH=claude
# REPOACH_CLAUDE_CODE_DEFAULT_MODEL=sonnet
# REPOACH_CLAUDE_CODE_SUBPROCESS_TIMEOUT=600.0

# ---- Proxy default model & thinking ----
# REPOACH_PROXY_DEFAULT_MODEL=nvidia_nim/z-ai/glm4.7
# REPOACH_PROXY_ENABLE_THINKING=true

# ---- Proxy HTTP timeouts & deadlines (seconds) ----
# REPOACH_PROXY_HTTP_CONNECT_TIMEOUT=2.0
# REPOACH_PROXY_HTTP_READ_TIMEOUT=120.0
# REPOACH_PROXY_HTTP_WRITE_TIMEOUT=10.0
# REPOACH_PROXY_FIRST_BYTE_DEADLINE_S=20.0
# REPOACH_DISPATCH_TOTAL_BUDGET_S=900.0

# ---- Proxy per-provider concurrency & rate limiting ----
# REPOACH_PROXY_PROVIDER_MAX_CONCURRENCY=5
# REPOACH_PROXY_PROVIDER_RATE_LIMIT=40
# REPOACH_PROXY_PROVIDER_RATE_WINDOW=60

# ---- Proxy output-budget retry (token-cap backoff) ----
# REPOACH_PROXY_BUDGET_RETRY_ENABLED=true
# REPOACH_PROXY_BUDGET_RETRY_CAP=8192
# REPOACH_PROXY_BUDGET_RETRY_FACTOR=8
# REPOACH_PROXY_BUDGET_RETRY_FLOOR=512

# ---- Proxy logging ----
# REPOACH_PROXY_LOG_FILE=server.log
# Log full request/response bodies (secrets are redacted first). Off by
# default — opt in only when debugging.
# REPOACH_PROXY_LOG_FULL_CONTENT=false

# ---- Circuit breaker (self-healing failover) ----
# REPOACH_BREAKER_ENABLED=true
# REPOACH_BREAKER_QUARANTINE_THRESHOLD=3
# REPOACH_BREAKER_TTL_S=120.0
# REPOACH_BREAKER_TTL_QUARANTINE_S=21600.0
# REPOACH_BREAKER_TTL_TERMINAL_S=604800.0
# Slow-success strike policy (k-of-n slow completions bench a hop).
# REPOACH_BREAKER_SLOW_K=3
# REPOACH_BREAKER_SLOW_N=5
# REPOACH_BREAKER_SLOW_SHADOW=true
# REPOACH_BREAKER_SLOW_LATENCY_GATE_S=10.0
# REPOACH_BREAKER_SLOW_TPS_FLOOR=1.0
# REPOACH_BREAKER_SLOW_TTL_S=300.0
# Persist and rehydrate breaker trip state across restarts.
# REPOACH_BREAKER_STATE_PERSIST_ENABLED=true
# REPOACH_BREAKER_PROBE_SEED_ENABLED=true
# REPOACH_BREAKER_PROBE_SEED_DB=./data/repoach.db

# ---- Regen sweep (bounded in-cycle cell refresh) ----
# REPOACH_REGEN_MAX_CELL_AGE_H=12.0
# REPOACH_REGEN_SWEEP_PACING_S=0.5
# REPOACH_REGEN_SWEEP_PER_PROVIDER_CAP=12
# REPOACH_REGEN_SWEEP_PER_PROVIDER_CONCURRENCY=2
# REPOACH_REGEN_SWEEP_RETRY_BACKOFF_S=2.0

# ---- Credits & chain-status health ----
# REPOACH_CREDITS_FLOOR_USD=2.0
# REPOACH_CREDITS_HEALTH_CACHE_TTL_S=3600.0
# REPOACH_CHAIN_STATUS_WINDOW_H=24.0

# ---- Chainpilot (self-evolving routing autopilot) ----
# Apply routing mutations (off by default — shadow-only until enabled).
# REPOACH_CHAINPILOT_APPLY_ENABLED=false
# REPOACH_CHAINPILOT_MAX_MUTATIONS=2
# REPOACH_EFFORT_MAP_SEED_ENABLED=true
