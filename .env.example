# Repoach — configuration template.
# Copy to .env (never commit the actual .env file).
# REPOACH_ is the only prefix read for core settings; the llm_proxy
# vars additionally accept their bare legacy names (see
# src/repoach/llm_proxy/config/env.example), with REPOACH_ winning
# when both are set.

# ==== Environment ====
REPOACH_ENV=dev
REPOACH_LOG_LEVEL=INFO

# ==== Storage (review-team persistence) ====
REPOACH_DB_PATH=./data/repoach.db

# ==== LLM proxy sidecar (serves the review factory) ====
REPOACH_LLM_PROXY_BASE_URL=http://localhost:8082
# Mandatory for any agent run and for non-loopback proxy binds —
# the proxy refuses to construct settings with a public host and an
# empty token, and AgentLoop refuses to start without it.
REPOACH_ANTHROPIC_AUTH_TOKEN=
REPOACH_PROXY_HOST=127.0.0.1
REPOACH_PROXY_PORT=8082

# ==== Provider API keys (read by the proxy) ====
REPOACH_NVIDIA_NIM_API_KEY=
REPOACH_OPENROUTER_API_KEY=

# ==== Model chains ====
# The capability chains live ONLY in the version-controlled
# ``chains.env`` at the repo root, under the bare ``MODEL_OPUS`` /
# ``MODEL_SONNET`` / ``MODEL_HAIKU`` keys — SP-CHAINS-SINGLE-SOURCE
# makes that file authoritative, so prefixed ``*_MODEL_*`` entries
# here would be ignored. Edit the chains in chains.env.

# ==== Auto-merge CI gate (SP-AUTOMERGE-EVENT-DRIVEN) ====
# Wait budget for required CI checks in ``review merge`` / ``review
# gate``. 0 = single evaluation, fail fast — CI sets 0 so the merge
# job never holds the runner slot polling (merge-on-ci.yml retries on
# CI completion). Unset = the local defaults below.
# REPOACH_AUTOMERGE_CI_WAIT_SECONDS=720
# REPOACH_AUTOMERGE_CI_POLL_INTERVAL=30

# ==== Review push notification (optional) ====
REPOACH_CLAUDE_CODE_ROUTINE_ID=
REPOACH_CLAUDE_CODE_ROUTINE_TOKEN=

# ==== Planner / Coder knobs (optional) ====
# Planner per-session parse-attempt budget (initial attempt + N-1
# refinements); unset or non-integer falls back to 5, clamped to >=1.
# REPOACH_PLANNER_PARSE_ATTEMPTS=5
# CSV of pytest interpreter names/paths for the Coder's local gate
# matrix, e.g. "python3.11,python3.13"; unset -> bare `pytest` on PATH.
# REPOACH_CODER_PYTHONS=
