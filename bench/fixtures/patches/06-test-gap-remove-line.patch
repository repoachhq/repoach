 }
+
+/** Return a copy of the cart with `units` fewer of `sku`, dropping a line that reaches zero. */
+export function removeUnits(lines: readonly CartLine[], sku: string, units: number): CartLine[] {
+  return lines
+    .map((l) => (l.sku === sku ? { ...l, quantity: l.quantity - units } : l))
+    .filter((l) => l.quantity > 0);
+}
