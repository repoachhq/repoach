+def bulk_price(price_cents: int, units: int) -> int:
+    """Return the price of ``units`` units: 5 % off from 10 units, 10 % off from 50.
+
+    Args:
+        price_cents: The unit price.
+        units: The units ordered.
+    """
+    if units >= 50:
+        return apply_discount(price_cents * units, 10)
+    if units >= 10:
+        return apply_discount(price_cents * units, 5)
+    return price_cents * units
