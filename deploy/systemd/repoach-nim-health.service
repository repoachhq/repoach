[Unit]
Description=Repoach — NIM chain-head health probe (feeds nim_health_probe)
Documentation=https://github.com/repoachhq/repoach
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPOACH_HOME@
# ``repoach monitor-chains`` exits 1 when any chain head is empty/error
# — that is telemetry, not a unit failure, hence SuccessExitStatus.
ExecStart=@REPOACH_HOME@/.venv/bin/repoach monitor-chains
SuccessExitStatus=0 1
StandardOutput=append:@REPOACH_HOME@/logs/nim_health.log
StandardError=append:@REPOACH_HOME@/logs/nim_health.log
