[Unit]
Description=Ferova — NIM chain-head health probe (feeds nim_health_probe)
Documentation=https://github.com/ferovahq/ferova
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/work/ferova
# ``ferova monitor-chains`` exits 1 when any chain head is empty/error
# — that is telemetry, not a unit failure, hence SuccessExitStatus.
ExecStart=%h/Documents/work/ferova/.venv/bin/ferova monitor-chains
SuccessExitStatus=0 1
StandardOutput=append:%h/Documents/work/ferova/logs/nim_health.log
StandardError=append:%h/Documents/work/ferova/logs/nim_health.log
